# =============================================================================
# NOVA ViA AI Systems - Environment Configuration
# =============================================================================
# 
# SECURITY WARNING: This is a template file. DO NOT use these placeholder values
# in production. Generate secure, random values for all secrets and credentials.
# 
# To generate secure secrets, use:
#   - SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   - ENCRYPTION_KEY: python -c "import secrets; print(secrets.token_hex(32))"
#   - Passwords: Use a password manager or: python -c "import secrets; print(secrets.token_urlsafe(24))"
# 
# =============================================================================

# Application Settings
APP_NAME=NOVA_ViA_AI_Systems
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Security & Encryption
# CRITICAL: Replace all placeholder values below with secure, randomly-generated secrets
SECRET_KEY=CHANGE_ME_generate_secure_random_32_char_minimum
ENCRYPTION_KEY=CHANGE_ME_generate_secure_32_byte_hex_key
JWT_SECRET_KEY=CHANGE_ME_generate_secure_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Database Configuration
# CRITICAL: Change default passwords before deployment
DATABASE_URL=postgresql://novavia_user:CHANGE_ME_db_password@localhost:5432/novavia
TIMESCALEDB_URL=postgresql://novavia_user:CHANGE_ME_db_password@localhost:5433/novavia_timeseries
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
# CRITICAL: Set a strong Redis password
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0

# Message Queue (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=novavia-ai-systems
KAFKA_AUTO_OFFSET_RESET=earliest

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=300

# ANEP Service Configuration
ANEP_HOST=0.0.0.0
ANEP_PORT=8001
ANEP_WORKERS=2

# IRIP Service Configuration
IRIP_HOST=0.0.0.0
IRIP_PORT=8002
IRIP_WORKERS=2

# Medical Device Integration
WAVI_EEG_IP=192.168.1.100
WAVI_EEG_PORT=8080
WAVI_SAMPLING_RATE=500
WAVI_CHANNELS=32
WAVI_API_KEY=CHANGE_ME_wavi_device_api_key

# Biohacking Device APIs
HYPERBARIC_CHAMBER_IP=192.168.1.101
HYPERBARIC_CHAMBER_PORT=8081
REDLIGHT_THERAPY_IP=192.168.1.102
REDLIGHT_THERAPY_PORT=8082
PEMF_DEVICE_IP=192.168.1.103
PEMF_DEVICE_PORT=8083
FREQUENCY_DEVICE_IP=192.168.1.104
FREQUENCY_DEVICE_PORT=8084

# Lab Integration (30-min rapid system)
LAB_SYSTEM_IP=192.168.1.105
LAB_SYSTEM_PORT=8085
LAB_API_KEY=CHANGE_ME_lab_system_api_key
LAB_RESULTS_ENDPOINT=/api/v1/results

# AI Model Configuration
# Get API keys from: OpenAI (platform.openai.com), Anthropic (console.anthropic.com), HuggingFace (huggingface.co)
OPENAI_API_KEY=CHANGE_ME_sk-your_openai_key
ANTHROPIC_API_KEY=CHANGE_ME_sk-ant-your_anthropic_key
HUGGINGFACE_API_KEY=CHANGE_ME_your_huggingface_token

# Model Paths
EEG_MODEL_PATH=./anep/eeg_processor/models/neuroplasticity_predictor.pkl
CIRCADIAN_MODEL_PATH=./anep/circadian_optimizer/models/circadian_analyzer.pkl
RISK_ASSESSMENT_MODEL_PATH=./irip/analytics/models/risk_predictor.pkl
OUTCOME_PREDICTION_MODEL_PATH=./irip/analytics/models/outcome_predictor.pkl

# Cloud Storage (AWS S3)
# CRITICAL: Never commit actual AWS credentials
AWS_ACCESS_KEY_ID=CHANGE_ME_AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=CHANGE_ME_wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-west-2
AWS_S3_BUCKET=novavia-data-storage

# Azure Configuration (Alternative)
# CRITICAL: Never commit actual Azure credentials
AZURE_STORAGE_ACCOUNT=novaviastorage
AZURE_STORAGE_KEY=CHANGE_ME_azure_storage_key_base64
AZURE_CONTAINER_NAME=patient-data

# Google Cloud Configuration (Alternative)
# Use service account key file (keep file secure, add to .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json
GCP_PROJECT_ID=novavia-ai-systems
GCP_BUCKET_NAME=novavia-gcp-storage

# Monitoring & Logging
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# HIPAA Compliance
AUDIT_LOGGING=true
DATA_ENCRYPTION_AT_REST=true
DATA_ENCRYPTION_IN_TRANSIT=true
PHI_ACCESS_LOGGING=true
SESSION_TIMEOUT_MINUTES=30

# Email Configuration (for alerts)
# CRITICAL: Use app-specific passwords for Gmail, not your main password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@novavia.com
SMTP_PASSWORD=CHANGE_ME_smtp_app_specific_password
SMTP_USE_TLS=true

# Twilio (for SMS alerts)
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=CHANGE_ME_AC_twilio_account_sid
TWILIO_AUTH_TOKEN=CHANGE_ME_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Emergency Contact System
EMERGENCY_CONTACT_PHONE=+1-800-EMERGENCY
EMERGENCY_EMAIL=emergency@novavia.com
CRISIS_INTERVENTION_ENABLED=true

# Treatment Protocol Configuration
METHADONE_MAX_DOSE=120
SUBOXONE_MAX_DOSE=24
KETAMINE_ENABLED=true
PLANT_MEDICINE_ENABLED=true
PLANT_MEDICINE_SUPERVISORS_REQUIRED=2

# Blockchain Integration (for billing)
# CRITICAL: NEVER commit private keys to version control
BLOCKCHAIN_NETWORK=ethereum
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_PRIVATE_KEY=CHANGE_ME_NEVER_COMMIT_PRIVATE_KEYS
BLOCKCHAIN_GAS_LIMIT=100000

# Performance Tuning
MAX_CONCURRENT_PATIENTS=1000
EEG_BUFFER_SIZE=10000
DEVICE_COMMAND_TIMEOUT_MS=100
PREDICTION_CACHE_TTL_SECONDS=300

# Development Tools
# CRITICAL: Change default admin credentials
PGADMIN_EMAIL=admin@novavia.com
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_secure_password
JUPYTER_NOTEBOOK_ENABLED=false
JUPYTER_TOKEN=CHANGE_ME_jupyter_secure_token

# Testing Configuration
# Use different credentials for test database
TEST_DATABASE_URL=postgresql://novavia_test:CHANGE_ME_test_db_password@localhost:5432/novavia_test
PYTEST_COVERAGE_THRESHOLD=90

# Feature Flags
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_DEVICE_SIMULATION=true
ENABLE_MOCK_EEG_DATA=true
ENABLE_ADVANCED_ANALYTICS=true
