# =============================================================================
# NOVA ViA AI Systems - Environment Configuration
# =============================================================================

# Application Settings
APP_NAME=NOVA_ViA_AI_Systems
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Security & Encryption
SECRET_KEY=your-super-secret-key-here-change-in-production
ENCRYPTION_KEY=your-32-byte-encryption-key-for-hipaa-compliance
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/novavia
TIMESCALEDB_URL=postgresql://postgres:password@localhost:5433/novavia_timeseries
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redispassword
REDIS_DB=0

# Message Queue (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=novavia-ai-systems
KAFKA_AUTO_OFFSET_RESET=earliest

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=300

# ANEP Service Configuration
ANEP_HOST=0.0.0.0
ANEP_PORT=8001
ANEP_WORKERS=2

# IRIP Service Configuration
IRIP_HOST=0.0.0.0
IRIP_PORT=8002
IRIP_WORKERS=2

# Medical Device Integration
WAVI_EEG_IP=192.168.1.100
WAVI_EEG_PORT=8080
WAVI_SAMPLING_RATE=500
WAVI_CHANNELS=32
WAVI_API_KEY=your-wavi-api-key

# Biohacking Device APIs
HYPERBARIC_CHAMBER_IP=192.168.1.101
HYPERBARIC_CHAMBER_PORT=8081
REDLIGHT_THERAPY_IP=192.168.1.102
REDLIGHT_THERAPY_PORT=8082
PEMF_DEVICE_IP=192.168.1.103
PEMF_DEVICE_PORT=8083
FREQUENCY_DEVICE_IP=192.168.1.104
FREQUENCY_DEVICE_PORT=8084

# Lab Integration (30-min rapid system)
LAB_SYSTEM_IP=192.168.1.105
LAB_SYSTEM_PORT=8085
LAB_API_KEY=your-lab-system-api-key
LAB_RESULTS_ENDPOINT=/api/v1/results

# AI Model Configuration
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Model Paths
EEG_MODEL_PATH=./anep/eeg_processor/models/neuroplasticity_predictor.pkl
CIRCADIAN_MODEL_PATH=./anep/circadian_optimizer/models/circadian_analyzer.pkl
RISK_ASSESSMENT_MODEL_PATH=./irip/analytics/models/risk_predictor.pkl
OUTCOME_PREDICTION_MODEL_PATH=./irip/analytics/models/outcome_predictor.pkl

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2
AWS_S3_BUCKET=novavia-data-storage

# Azure Configuration (Alternative)
AZURE_STORAGE_ACCOUNT=novaviastorage
AZURE_STORAGE_KEY=your-azure-storage-key
AZURE_CONTAINER_NAME=patient-data

# Google Cloud Configuration (Alternative)
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json
GCP_PROJECT_ID=novavia-ai-systems
GCP_BUCKET_NAME=novavia-gcp-storage

# Monitoring & Logging
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# HIPAA Compliance
AUDIT_LOGGING=true
DATA_ENCRYPTION_AT_REST=true
DATA_ENCRYPTION_IN_TRANSIT=true
PHI_ACCESS_LOGGING=true
SESSION_TIMEOUT_MINUTES=30

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@novavia.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=true

# Twilio (for SMS alerts)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Emergency Contact System
EMERGENCY_CONTACT_PHONE=+1-800-EMERGENCY
EMERGENCY_EMAIL=emergency@novavia.com
CRISIS_INTERVENTION_ENABLED=true

# Treatment Protocol Configuration
METHADONE_MAX_DOSE=120
SUBOXONE_MAX_DOSE=24
KETAMINE_ENABLED=true
PLANT_MEDICINE_ENABLED=true
PLANT_MEDICINE_SUPERVISORS_REQUIRED=2

# Blockchain Integration (for billing)
BLOCKCHAIN_NETWORK=ethereum
BLOCKCHAIN_CONTRACT_ADDRESS=0x...
BLOCKCHAIN_PRIVATE_KEY=your-private-key
BLOCKCHAIN_GAS_LIMIT=100000

# Performance Tuning
MAX_CONCURRENT_PATIENTS=1000
EEG_BUFFER_SIZE=10000
DEVICE_COMMAND_TIMEOUT_MS=100
PREDICTION_CACHE_TTL_SECONDS=300

# Development Tools
PGADMIN_EMAIL=admin@novavia.com
PGADMIN_PASSWORD=admin
JUPYTER_NOTEBOOK_ENABLED=false
JUPYTER_TOKEN=your-jupyter-token

# Testing Configuration
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/novavia_test
PYTEST_COVERAGE_THRESHOLD=90

# Feature Flags
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_DEVICE_SIMULATION=true
ENABLE_MOCK_EEG_DATA=true
ENABLE_ADVANCED_ANALYTICS=true
